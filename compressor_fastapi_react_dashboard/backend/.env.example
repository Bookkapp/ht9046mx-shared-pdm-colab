# This service and the scoring runner read telemetry directly from MySQL.
# Do not put a password in Git. Create backend\.env on the server from this file.
MODEL_PROJECT_ROOT=C:\HT9046MX\app
CONTROLLED_SYSTEM_CONFIG=C:\HT9046MX\state\config\controlled_condition_monitoring.json
CONTROLLED_POLICY_FILE=C:\HT9046MX\app\configs\controlled_condition_monitoring_policy.json
CONTROLLED_RUNTIME_DIR=C:\HT9046MX\state\controlled_runtime
SHARED_MODEL_ARTIFACT=C:\HT9046MX\app\artifacts\shared_lstm_colab_full

MYSQL_HOST=10.195.17.73
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ht9046mx_iot
READINGS_TABLE=ht9046mx_readings
READINGS_MACHINE_COLUMN=machine_number
READINGS_TIMESTAMP_COLUMN=recorded_at
# Leave blank for wide columns such as Hp_1st_1 ... TempLo_8.
# Set it only when one DB row represents one module.
READINGS_MODULE_COLUMN=

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
# Public address of this Web App server: http://10.195.17.69:8000
DASHBOARD_REFRESH_SECONDS=15
DASHBOARD_CHART_POINT_LIMIT=576
DASHBOARD_PREDICTION_READ_LIMIT=20000
API_PREFIX=/api/v1
# Required for profile approve/reject actions in production.
API_KEY=change-this-before-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_DIST=..\frontend\dist
