# This service reads synchronized logs and Controlled Hybrid runtime artifacts.
# Git owns C:\HT9046MX\app. Dashboard-writable state lives outside it so a
# future git pull cannot overwrite handler or profile configuration.
# It does not connect to MySQL; MYSQL_* variables are intentionally not used.
MODEL_PROJECT_ROOT=C:\HT9046MX\app
CONTROLLED_SYSTEM_CONFIG=C:\HT9046MX\state\config\controlled_condition_monitoring.json
CONTROLLED_POLICY_FILE=C:\HT9046MX\app\configs\controlled_condition_monitoring_policy.json
CONTROLLED_RUNTIME_DIR=C:\HT9046MX\state\controlled_runtime
SHARED_MODEL_ARTIFACT=C:\HT9046MX\app\artifacts\shared_lstm_colab_full

HANDLERS_FILE=C:\HT9046MX\state\config\handlers.json
HANDLER_DESTINATION_ROOT=C:\HT9046MX\data\incoming
HANDLER_SHARE_TEMPLATE=Comp_log_data_{machine_code}

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_REFRESH_SECONDS=15
DASHBOARD_CHART_POINT_LIMIT=576
DASHBOARD_PREDICTION_READ_LIMIT=20000
API_PREFIX=/api/v1
# Required for approve/reject and handler writes in production.
API_KEY=change-this-before-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_DIST=..\frontend\dist
